// Find users by email (exact match)
exports.findUserByEmail = async (req, res) => {
  try {
    const { email } = req.params;
    const user = await User.find({ email });
    return res.status(200).json({
      success: true,
      data: user,
    });
  } catch (e) {
    res.status(400).json({
      success: false,
      error: e.message || "Failed to find user",
    });
  }
};